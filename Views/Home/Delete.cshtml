@model Nhom7.Models.Xe

@{
    ViewData["Title"] = "Xóa xe";
}

<h2>Xóa xe</h2>

<div class="alert alert-danger">

    Bạn có chắc muốn xóa xe này không?

</div>

<table class="table">

    <tr>
        <th>Mã xe</th>
        <td>@Model.MaXe</td>
    </tr>

    <tr>
        <th>Tên xe</th>
        <td>@Model.TenXe</td>
    </tr>

    <tr>
        <th>Hãng</th>
        <td>@Model.TenHang</td>
    </tr>

    <tr>
        <th>Màu sắc</th>
        <td>@Model.MauSac</td>
    </tr>

</table>

<form asp-action="Delete" method="post">

    <input type="hidden"
           asp-for="MaXe" />

    <button type="submit"
            class="btn btn-danger">

        Xác nhận xóa

    </button>

    <a asp-action="Index"
       class="btn btn-secondary">

        Hủy

    </a>

</form>